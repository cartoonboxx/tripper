{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "vue",
    "vitest"
  ],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.vue"
      ],
      "rules": {
        "vue/no-reserved-component-names": "off"
      }
    }
  ]
}
